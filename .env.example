# Gemini AI API for document parsing and question generation
GEMINI_API_KEY="your-gemini-api-key"

# Public app URL (optional for local development)
APP_URL="http://localhost:3000"

# Supabase Database Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Exam Analytics (opsional). Secret penanda tangan token analitik.
# Bila kosong, server memakai secret acak per proses (aman untuk 1 proses pm2).
# ANALYTICS_TOKEN_SECRET="isi-dengan-string-acak-panjang"

